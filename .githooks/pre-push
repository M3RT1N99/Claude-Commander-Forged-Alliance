#!/bin/sh
#
# Das echte Gate. Es läuft LOKAL, weil es hier laufen muss: 49 der 62 Suiten
# lesen die Original-Spieldateien aus der FA-Installation, und die gibt es auf
# keinem CI-Runner. Ein GitHub-Workflow kann hier nur typechecken.
#
# Warum es das gibt: Commit 8325662 ("codex work", 17 Dateien, kein Body) machte
# jede Turmwaffe schussunfähig und wurde ROT gepusht — verify-combat war zu dem
# Zeitpunkt unverändert und muss fehlgeschlagen sein. Erst der nächste Commit
# meldete "verify-combat green again". Kampf war ~23 Stunden committeter
# Historie tot, weil niemand vor dem Push geprüft hat.
#
# Aktivieren (einmalig):   git config core.hooksPath .githooks
# Umgehen (nur bewusst):   git push --no-verify
set -e

echo "── pre-push: Typecheck (src)"
npx tsc --noEmit

# Und die Skripte. `tsconfig.json` schliesst `scripts/` aus (include: ["src"]),
# also lief JEDES Verifikationsgate jahrelang ungeprüft durch den Typechecker —
# "Typecheck grün" hiess: grün für den Teil, den `npm test` gar nicht ausführt.
# Seit dem Aufräumen ist es sauber und darf deshalb ein Gate sein.
echo "── pre-push: Typecheck (scripts)"
npm run --silent typecheck:scripts

echo "── pre-push: alle Suiten"
npm test

echo "── pre-push: grün"
